# Plantilla del .env del docker-compose.yml raiz (stack backend+front).
# En cada maquina (tu PC o el server del cliente):
#   1) copiar:  cp .env.example .env   (o copiar/renombrar a mano en Windows)
#   2) completar los valores de abajo
#   3) docker compose up -d --build

# IP donde se accede al stack (esta PC en local; la del server en produccion).
# Se HORNEA en el front y el APK -> a donde pega el navegador/tablet.
SERVER_IP=192.168.0.100

# SQL Server visto DESDE el contenedor (IP + puerto, NO 'localhost' ni \SQLEXPRESS).
DB_HOST=192.168.0.100,1433
DB_HOST_SAR=192.168.0.100,1433

# Credenciales (login SQL) de cada base. En cada server se cambian por las de ahi.
#   EOL_TBAR:
DB_USER=eol_app
DB_PASS=<clave>
#   TB-L (app de camaras de door trims, .153) -> docker-compose.door.yml. Solo lectura.
DB_HOST_TBL=172.17.132.153,1433
DB_USER_TBL=dx
DB_PASS_TBL=<clave de TB-L>
#   JITMS:
DB_USER_SAR=eol_app
DB_PASS_SAR=<clave>
