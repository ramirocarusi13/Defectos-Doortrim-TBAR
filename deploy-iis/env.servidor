# ============================================================================
#  backend\.env del SERVIDOR (.150, IIS). Copiar este archivo a backend\.env y
#  completar lo que esta entre < >. Nunca subir el .env con claves al repo.
# ============================================================================
APP_NAME="DOORTRIM DEFECTOS"
APP_ENV=production
# Se genera con: php artisan key:generate
APP_KEY=
APP_DEBUG=false
APP_URL=http://172.17.132.150:9001

# EOL_TBAR: donde se guardan los defectos, cambios y piezas de door (misma base
# que EOL Defectos de asientos). SQL Server del .150.
DB_CONNECTION=sqlsrv
DB_HOST=172.17.132.150,1433
DB_PORT=
DB_DATABASE=EOL_TBAR
DB_USERNAME=<usuario de EOL_TBAR>
DB_PASSWORD=<clave de EOL_TBAR>

# JITMS: door NO lo usa. Queda apagado y bloqueado para escritura por las dudas.
DB_HOST_SAR=SIN_CONFIGURAR
DB_PORT_SAR=
DB_DATABASE_SAR=JITMS
DB_USERNAME_SAR=
DB_PASSWORD_SAR=
EOL_INTERLOCK_ENABLED=false
JITMS_SOLO_LECTURA=true

# TB-L / TB-PLC (.153): QR de la app de camaras y tabla del puesto. SOLO LECTURA
# (el backend rechaza cualquier escritura antes de mandarla).
DB_HOST_TBL=172.17.132.153,1433
DB_PORT_TBL=
DB_DATABASE_TBL=TB-L
DB_USERNAME_TBL=dx
DB_PASSWORD_TBL=<clave de TB-L>
# Ultimo QR que carga el puesto (id, QR, fecha, usuario)
DOOR_CONTROL_FINAL_TABLA=[TB-PLC].[dbo].[tblDoorMain]
# Hora del panel en TB-L (vacio = el panel no controla curado)
DOOR_TBL_SQL_PANEL=

LOG_CHANNEL=daily
LOG_LEVEL=warning
CACHE_DRIVER=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
