<?xml version="1.0" encoding="utf-8"?>
<!--
  Config de RESCATE: igual a la de kiosco pero con el modo kiosco APAGADO.
  La empuja QUITAR-KIOSCO.bat para poder volver a usar la tablet normal
  (EHS queda como launcher con la lista de apps permitidas, sin encierro).
-->
<config>
    <kiosk>
        <application label="EOL Defectos" package="com.tbar.eolleves" activity="com.tbar.eolleves.MainActivity"/>
    </kiosk>
    <applications>
        <application label="EOL Defectos" package="com.tbar.eolleves" activity="com.tbar.eolleves.MainActivity"/>
    </applications>
    <tools>
        <application label="Ajustes" package="com.android.settings"/>
        <application label="StageNow" package="com.symbol.tool.stagenow"/>
    </tools>
    <passwords>
        <admin></admin>
    </passwords>
    <preferences>
        <title>EOL Defectos</title>
        <kiosk_mode_enabled>0</kiosk_mode_enabled>
        <usb_debugging_disabled>0</usb_debugging_disabled>
    </preferences>
</config>
